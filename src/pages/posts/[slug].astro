---
import { env } from 'cloudflare:workers';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Datetime from '@/components/Datetime.astro';
import AdSlot from '@/components/AdSlot.astro';
import BackButton from '@/components/BackButton.astro';
import BackToTopButton from '@/components/BackToTopButton.astro';
import ShareLinks from '@/components/ShareLinks.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import Comments from '@/components/Comments.astro';
import { SITE } from '@/config';
import { getAdSlots, getPublishedCommentsBySlug, getPublicPostBySlug, getPublicSettings, getRelatedPosts } from '@/lib/content-service';
import { getDb } from '@/lib/db';

type Post = {
  id: number;
  title: string;
  slug: string;
  content: string;
  description?: string;
  tags?: string;
  category?: string;
  featured?: boolean;
  viewCount?: number;
  createdAt: string | number;
  updatedAt?: string | number;
};

type Comment = {
  id: number;
  author: string;
  content: string;
  createdAt: string | number;
};

const { slug } = Astro.params;
let post: Post | undefined;
let related: Post[] = [];
let comments: Comment[] = [];
let commentsEnabled = true;
let tagsEnabled = true;
let adSlots = [];

try {
  const db = getDb(env.DB);
  post = await getPublicPostBySlug(db, slug || '') as Post | undefined;
  if (post) {
    const publicConfig = await getPublicSettings(db);
    commentsEnabled = publicConfig.settings.commentsEnabled;
    tagsEnabled = publicConfig.settings.tagsEnabled;
    related = await getRelatedPosts(db, post.slug) as Post[] ?? [];
    comments = await getPublishedCommentsBySlug(db, post.slug) as Comment[] ?? [];
    adSlots = await getAdSlots(db);
    Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600, stale-while-revalidate=3600');
  }
} catch {
  post = undefined;
}

if (!post) return Astro.redirect('/');

const pubDatetime = new Date(post.createdAt);
const modDatetime = post.updatedAt ? new Date(post.updatedAt) : null;
const tags = String(post.tags || '').split(',').map(tag => tag.trim()).filter(Boolean);
const description = post.description || post.content.replace(/[#>*_\[\]`-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 160);
const canonicalURL = new URL(`/posts/${post.slug}/`, SITE.website);
const unsafeHtml = await marked.parse(post.content);
const content = sanitizeHtml(unsafeHtml, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img', 'h1', 'h2', 'h3', 'h4', 'pre', 'code', 'video', 'source', 'track']),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    img: ['src', 'alt', 'title'],
    a: ['href', 'name', 'target', 'rel'],
    code: ['class'],
    pre: ['class'],
    video: ['src', 'controls', 'poster', 'preload', 'width', 'height', 'playsinline', 'muted', 'loop'],
    source: ['src', 'type'],
    track: ['src', 'kind', 'srclang', 'label', 'default']
  },
  allowedSchemes: ['http', 'https', 'mailto']
});
---

<Layout
  title={`${post.title} | ${SITE.title}`}
  description={description}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  keywords={tags}
  articleSection={post.category || '随笔'}
  scrollSmooth={true}
>
  <Header />
  <BackButton />
  <main id="main-content" class:list={["app-layout pb-12", { "mt-8": !SITE.showBackButton }]} data-pagefind-body>
    <article class="surface-card mt-4 overflow-hidden p-6 sm:p-8">
      <div class="mb-6 flex flex-wrap items-center gap-2 text-sm text-subtle">
        <a class="chip border-accent/30 text-accent" href={`/archive/?category=${encodeURIComponent(post.category || '随笔')}`}>{post.category || '随笔'}</a>
        {post.featured && <span class="chip">推荐</span>}
        <span>{Number(post.viewCount || 0)} 次阅读</span>
      </div>
      <h1 class="max-w-4xl text-3xl font-bold leading-tight text-foreground sm:text-5xl">{post.title}</h1>
      <div class="mt-5 flex flex-wrap items-center gap-4 text-subtle">
        <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} size="lg" />
      </div>
      {tagsEnabled && tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {tags.map(tag => <a class="chip" href={`/archive/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}
        </div>
      )}
      {description && <p class="mt-6 max-w-3xl text-base leading-7 text-subtle">{description}</p>}
    </article>

    <AdSlot position="content_top" class="mt-6" adSlots={adSlots} />

    <article
      id="article"
      class="app-prose surface-card mt-6 w-full p-6 sm:p-8 prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
      set:html={content}
    />

    <AdSlot position="content_bottom" class="mt-6" adSlots={adSlots} />
    <RelatedPosts posts={related} tagsEnabled={tagsEnabled} />
    <Comments slug={post.slug} comments={comments} enabled={commentsEnabled} />
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6">
      <BackToTopButton />
      <ShareLinks />
    </div>
  </main>
  <Footer />
</Layout>
