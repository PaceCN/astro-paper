---
import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PostCard from '@/components/PostCard.astro';
import { SITE } from '@/config';
import { getPublicPosts } from '@/lib/content-service';
import { getDb } from '@/lib/db';

type Post = {
  id: number;
  title: string;
  slug: string;
  content: string;
  description?: string;
  tags?: string;
  category?: string;
  featured?: boolean;
  createdAt: string | number;
};

const tag = Astro.url.searchParams.get('tag') || '';
const category = Astro.url.searchParams.get('category') || '';
let posts: Post[] = [];

try {
  const db = getDb(env.DB);
  posts = (await getPublicPosts(db, { pageSize: 50, tag, category })).posts as Post[];
  Astro.response.headers.set('Cache-Control', tag || category ? 'public, max-age=60, s-maxage=300, stale-while-revalidate=3600' : 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
} catch {
  posts = [];
}

const groups = posts.reduce<Record<string, Post[]>>((acc, post) => {
  const date = new Date(post.createdAt);
  const key = `${date.getFullYear()} 年 ${date.getMonth() + 1} 月`;
  acc[key] = acc[key] || [];
  acc[key].push(post);
  return acc;
}, {});
const title = tag ? `标签：${tag}` : category ? `分类：${category}` : '文章归档';
const description = tag || category ? `${title} 下的文章归档。` : `按时间浏览 ${SITE.title} 的已发布文章。`;
---

<Layout title={`${title} | ${SITE.title}`} description={description} robots={tag || category ? 'noindex,follow' : undefined}>
  <Header />
  <main id="main-content" class="app-layout pb-10">
    <section class="surface-card mt-4 p-8">
      <p class="mb-2 text-sm text-accent">Archive</p>
      <h1 class="text-3xl font-bold">{title}</h1>
      <p class="mt-3 text-subtle">共 {posts.length} 篇文章，按发布时间整理。</p>
    </section>

    <div class="mt-8 space-y-8">
      {Object.entries(groups).length ? Object.entries(groups).map(([group, items]) => (
        <section>
          <h2 class="mb-4 text-xl font-semibold text-accent">{group}</h2>
          <div class="grid gap-5">
            {items.map(post => <PostCard post={post} />)}
          </div>
        </section>
      )) : <p class="surface-card p-6 text-subtle">暂无匹配文章。</p>}
    </div>
  </main>
  <Footer />
</Layout>
