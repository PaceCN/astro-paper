---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Datetime from '@/components/Datetime.astro';
import LinkButton from '@/components/LinkButton.astro';
import AdSlot from '@/components/AdSlot.astro';
import IconArrowRight from '@/assets/icons/IconArrowRight.svg';
import { SITE } from '@/config';

type Post = {
  id: number;
  title: string;
  slug: string;
  content: string;
  createdAt: string | number;
};

let posts: Post[] = [];

function excerpt(content: string) {
  return content.replace(/[#>*_\[\]`-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 160);
}

try {
  const response = await fetch(new URL(`/api/posts?status=published&pageSize=${SITE.postPerIndex}`, Astro.url));
  const result = await response.json() as { success: boolean; data?: { posts: Post[] } };
  posts = result.data?.posts ?? [];
} catch {
  posts = [];
}
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <AdSlot position="header_bottom" class="max-w-app" />

    <section id="recent-posts" class="pt-8 pb-6">
        <h1 class="text-2xl font-semibold tracking-wide">最新文章</h1>
      {posts.length ? (
        <ul>
          {posts.map(post => (
            <li class="my-6">
              <a
                href={`/posts/${post.slug}/`}
                class:list={[
                  "inline-block text-lg font-medium text-accent",
                  "decoration-dashed underline-offset-4 hover:underline",
                  "focus-visible:no-underline focus-visible:underline-offset-0",
                ]}
              >
                <h2>{post.title}</h2>
              </a>
              <Datetime pubDatetime={new Date(post.createdAt)} />
              <p>{excerpt(post.content)}{post.content.length > 160 ? '...' : ''}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-6 text-muted-foreground">还没有公开文章。等我整理好第一篇记录再放出来。</p>
      )}
    </section>

    <AdSlot position="footer_top" class="max-w-app" />

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        全部文章
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset?.layout;
    if (indexLayout) sessionStorage.setItem("backUrl", "/");
  });
</script>
