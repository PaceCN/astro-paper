---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';

type Post = {
  id: number;
  title: string;
  slug: string;
  content: string;
  createdAt: string | number;
};

let posts: Post[] = [];

function excerpt(content: string) {
  return content.replace(/[#>*_\[\]-]/g, '').slice(0, 160);
}

try {
  const response = await fetch(new URL('/api/posts?status=published&pageSize=20', Astro.url));
  const result = await response.json() as { success: boolean; data?: { posts: Post[] } };
  posts = result.data?.posts ?? [];
} catch {
  posts = [];
}
---

<BaseLayout title="AI 全栈博客">
  <AdSlot position="content_top" />
  <div class="space-y-10">
    {posts.length ? posts.map((post) => (
      <article>
        <p class="mb-2 text-sm text-neutral-500">{new Date(post.createdAt).toLocaleDateString('zh-CN')}</p>
        <h1 class="mb-3 text-3xl font-semibold leading-tight">
          <a href={`/posts/${post.slug}`} class="no-underline hover:underline">{post.title}</a>
        </h1>
        <p class="text-neutral-700">{excerpt(post.content)}...</p>
      </article>
    )) : (
      <p class="text-neutral-600">暂无已发布文章。</p>
    )}
  </div>
  <AdSlot position="content_bottom" />
</BaseLayout>
