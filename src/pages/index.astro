---
import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PostCard from '@/components/PostCard.astro';
import SiteSidebar from '@/components/SiteSidebar.astro';
import AdSlot from '@/components/AdSlot.astro';
import { SITE } from '@/config';
import { getAdSlots, getPublicMeta, getPublicPosts } from '@/lib/content-service';
import { getDb } from '@/lib/db';

type Post = {
  id: number;
  title: string;
  slug: string;
  content: string;
  description?: string;
  tags?: string;
  category?: string;
  featured?: boolean;
  viewCount?: number;
  createdAt: string | number;
};

type Meta = {
  totalPosts: number;
  tags: { name: string; count: number }[];
  categories: { name: string; count: number }[];
  settings?: {
    tagsEnabled: boolean;
    site: { title: string; desc: string; author: string; profile: string; avatar: string };
    sidebar: { profile: boolean; tags: boolean; categories: boolean; stack: boolean };
    techStack: string[];
  };
};

let posts: Post[] = [];
let meta: Meta = { totalPosts: 0, tags: [], categories: [] };
let adSlots = [];

try {
  const db = getDb(env.DB);
  posts = (await getPublicPosts(db, { pageSize: SITE.postPerIndex })).posts as Post[];
  meta = await getPublicMeta(db);
  adSlots = await getAdSlots(db);
  Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600, stale-while-revalidate=86400');
} catch {
  posts = [];
  meta = { totalPosts: posts.length, tags: [], categories: [] };
  adSlots = [];
}
---

<Layout title={meta.settings?.site.title || SITE.title} description={meta.settings?.site.desc || SITE.desc}>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout pb-10">
    <section class="fade-up surface-card mt-4 overflow-hidden p-8 sm:p-10">
      <p class="mb-3 text-sm font-medium text-accent">好记性不如烂笔头</p>
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-foreground sm:text-5xl">{meta.settings?.site.title || SITE.title}</h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-subtle sm:text-lg">{meta.settings?.site.desc || SITE.desc}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-background" href="/archive/">浏览归档</a>
        <a class="rounded-full border border-border px-5 py-2.5 text-sm font-medium hover:text-accent" href="/about/">了解更多</a>
      </div>
    </section>

    <AdSlot position="header_bottom" class="mt-6" adSlots={adSlots} />

    <section class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="min-w-0">
        <div class="mb-5 flex items-center justify-between gap-3">
          <h2 class="text-2xl font-semibold">最新文章</h2>
          <a href="/archive/" class="text-sm text-accent hover:underline">全部文章</a>
        </div>
        {posts.length ? (
          <div class="grid gap-5">
            {posts.map(post => <PostCard post={post} tagsEnabled={meta.settings?.tagsEnabled ?? true} />)}
          </div>
        ) : (
          <p class="surface-card p-6 text-subtle">还没有公开文章。等我整理好第一篇记录再放出来。</p>
        )}
      </div>
      <SiteSidebar meta={meta} />
    </section>

    <AdSlot position="footer_top" class="mt-8" adSlots={adSlots} />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const indexLayout = (document.querySelector('#main-content') as HTMLElement)?.dataset?.layout;
    if (indexLayout) sessionStorage.setItem('backUrl', '/');
  });
</script>
