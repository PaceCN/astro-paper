---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="自动化与日期审计">
  <div id="automation-admin">
    <form
      data-login
      class="not-prose max-w-md rounded-lg border border-border p-4"
      hidden
    >
      <label class="block text-sm font-semibold" for="automation-admin-password"
        >后台密码</label
      >
      <input
        id="automation-admin-password"
        name="password"
        type="password"
        class="mt-2 w-full rounded border border-border bg-background px-3 py-2"
        required
      />
      <button
        class="mt-3 rounded bg-accent px-4 py-2 text-sm font-semibold text-white"
        type="submit">登录</button
      >
      <p data-login-error class="mt-2 text-sm text-red-600" hidden></p>
    </form>

    <div data-admin hidden>
      <p data-status class="text-sm opacity-75">读取自动化运行记录...</p>

      <h2>写入运行记录</h2>
      <form
        data-run-form
        class="not-prose grid gap-3 rounded-lg border border-border p-4 sm:grid-cols-3"
      >
        <label class="block text-sm"
          >类型<input
            name="runType"
            placeholder="morning"
            class="mt-1 w-full rounded border border-border bg-background px-3 py-2"
            required
          /></label
        >
        <label class="block text-sm"
          >状态<input
            name="status"
            placeholder="published"
            class="mt-1 w-full rounded border border-border bg-background px-3 py-2"
            required
          /></label
        >
        <label class="block text-sm"
          >阶段<input
            name="stage"
            placeholder="done"
            class="mt-1 w-full rounded border border-border bg-background px-3 py-2"
          /></label
        >
        <label class="block text-sm sm:col-span-3"
          >备注<input
            name="notes"
            class="mt-1 w-full rounded border border-border bg-background px-3 py-2"
          /></label
        >
        <div class="sm:col-span-3">
          <button
            class="rounded bg-accent px-4 py-2 text-sm font-semibold text-white"
            type="submit">记录</button
          ><span data-run-status class="ml-3 text-sm"></span>
        </div>
      </form>

      <h2>手动发布请求</h2>
      <form
        data-publish-form
        class="not-prose grid gap-3 rounded-lg border border-border p-4 sm:grid-cols-2"
      >
        <label class="block text-sm"
          >发布标题 / 任务名<input
            name="title"
            placeholder="例如：发布一篇 Cloudflare D1 后台实践文章"
            class="mt-1 w-full rounded border border-border bg-background px-3 py-2"
            required
          /></label
        >
        <label class="block text-sm"
          >类型<select
            name="requestType"
            class="mt-1 w-full rounded border border-border bg-background px-3 py-2"
          >
            <option value="manual_publish">手动发布</option>
            <option value="maintenance">维护/整理</option>
            <option value="refresh_index">同步索引</option>
          </select></label
        >
        <label class="block text-sm sm:col-span-2"
          >具体要求<textarea
            name="prompt"
            rows="5"
            placeholder="写清楚要整理、维护或发布什么；发布前仍会走验证、提交、推送和后台索引同步。"
            class="mt-1 w-full rounded border border-border bg-background px-3 py-2"
            required></textarea></label
        >
        <div class="sm:col-span-2">
          <button
            class="rounded bg-accent px-4 py-2 text-sm font-semibold text-white"
            type="submit">加入发布队列</button
          ><span data-publish-status class="ml-3 text-sm"></span>
        </div>
      </form>

      <h2>发布请求队列</h2>
      <div class="not-prose overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead
            ><tr
              ><th>时间</th><th>标题</th><th>类型</th><th>状态</th><th
                >结果/错误</th
              ></tr
            ></thead
          >
          <tbody data-publish-requests></tbody>
        </table>
      </div>
      <h2>最近运行</h2>
      <div class="not-prose overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead
            ><tr
              ><th>时间</th><th>类型</th><th>状态</th><th>阶段</th><th>草稿</th
              ><th>备注/错误</th></tr
            ></thead
          >
          <tbody data-runs></tbody>
        </table>
      </div>

      <h2>日期审计</h2>
      <div class="not-prose overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead
            ><tr
              ><th>时间</th><th>文件</th><th>pubDatetime</th><th>modDatetime</th
              ><th>原因</th><th>操作者</th></tr
            ></thead
          >
          <tbody data-audits></tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    const root = document.querySelector("#automation-admin");
    const loginForm = root?.querySelector("[data-login]");
    const admin = root?.querySelector("[data-admin]");
    const loginError = root?.querySelector("[data-login-error]");
    const status = root?.querySelector("[data-status]");
    const runStatus = root?.querySelector("[data-run-status]");
    const publishStatus = root?.querySelector("[data-publish-status]");
    const runsBody = root?.querySelector("[data-runs]");
    const auditsBody = root?.querySelector("[data-audits]");
    const publishBody = root?.querySelector("[data-publish-requests]");
    const runForm = root?.querySelector("[data-run-form]");
    const publishForm = root?.querySelector("[data-publish-form]");

    const api = async (path, options = {}) => {
      const response = await fetch(`/api/admin/${path}`, {
        credentials: "same-origin",
        headers: {
          "content-type": "application/json",
          ...(options.headers || {}),
        },
        ...options,
      });
      const data = await response.json();
      if (!response.ok)
        throw new Error(data.error || `API failed: ${response.status}`);
      return data;
    };

    const cell = (text, code = false) => {
      const td = document.createElement("td");
      if (code) {
        const codeEl = document.createElement("code");
        codeEl.textContent = text || "-";
        td.append(codeEl);
      } else {
        td.textContent = text || "-";
      }
      return td;
    };

    const emptyRow = (tbody, span) => {
      const tr = document.createElement("tr");
      const td = cell("暂无记录");
      td.colSpan = span;
      tr.append(td);
      tbody.replaceChildren(tr);
    };

    const renderRuns = runs => {
      if (!runs.length) return emptyRow(runsBody, 6);
      runsBody.replaceChildren(
        ...runs.map(run => {
          const tr = document.createElement("tr");
          tr.append(
            cell(run.created_at),
            cell(run.run_type),
            cell(run.status),
            cell(run.stage),
            cell(run.draft_path, true),
            cell(run.error || run.notes)
          );
          return tr;
        })
      );
    };

    const renderAudits = audits => {
      if (!audits.length) return emptyRow(auditsBody, 6);
      auditsBody.replaceChildren(
        ...audits.map(audit => {
          const tr = document.createElement("tr");
          tr.append(
            cell(audit.created_at),
            cell(audit.source_path, true),
            cell(
              `${audit.old_pub_datetime || "-"} → ${audit.new_pub_datetime || "-"}`
            ),
            cell(
              `${audit.old_mod_datetime || "-"} → ${audit.new_mod_datetime || "-"}`
            ),
            cell(audit.reason),
            cell(audit.actor)
          );
          return tr;
        })
      );
    };

    const renderPublishRequests = requests => {
      if (!requests.length) return emptyRow(publishBody, 5);
      publishBody.replaceChildren(
        ...requests.map(request => {
          const tr = document.createElement("tr");
          tr.append(
            cell(request.created_at),
            cell(request.title),
            cell(request.request_type),
            cell(request.status),
            cell(request.error || request.result_summary)
          );
          return tr;
        })
      );
    };

    const load = async () => {
      try {
        const [runs, audits, publishRequests] = await Promise.all([
          api("automation-runs"),
          api("date-audit"),
          api("publish-requests"),
        ]);
        renderRuns(runs.runs);
        renderAudits(audits.audits);
        renderPublishRequests(publishRequests.requests);
        status.textContent = "已从 BLOG_DB 读取自动化运行记录和日期审计。";
      } catch (error) {
        status.textContent = `D1 暂不可用：${error.message}`;
        renderRuns([]);
        renderAudits([]);
        renderPublishRequests([]);
      }
    };

    const refreshAuth = async () => {
      const me = await api("me");
      if (me.authenticated) {
        loginForm.hidden = true;
        admin.hidden = false;
        await load();
      } else {
        loginForm.hidden = false;
        admin.hidden = true;
      }
    };

    loginForm?.addEventListener("submit", async event => {
      event.preventDefault();
      loginError.hidden = true;
      try {
        await api("login", {
          method: "POST",
          body: JSON.stringify({ password: loginForm.password.value }),
        });
        loginForm.password.value = "";
        await refreshAuth();
      } catch (error) {
        loginError.textContent = error.message;
        loginError.hidden = false;
      }
    });

    runForm?.addEventListener("submit", async event => {
      event.preventDefault();
      runStatus.textContent = "写入中...";
      try {
        await api("automation-runs", {
          method: "POST",
          body: JSON.stringify({
            runType: runForm.runType.value,
            status: runForm.status.value,
            stage: runForm.stage.value,
            triggerSource: "manual_admin",
            requestedBy: "admin",
            notes: runForm.notes.value,
          }),
        });
        runStatus.textContent = "已记录";
        runForm.reset();
        await load();
      } catch (error) {
        runStatus.textContent = error.message;
      }
    });

    publishForm?.addEventListener("submit", async event => {
      event.preventDefault();
      publishStatus.textContent = "加入队列中...";
      try {
        await api("publish-requests", {
          method: "POST",
          body: JSON.stringify({
            title: publishForm.title.value,
            requestType: publishForm.requestType.value,
            prompt: publishForm.prompt.value,
            requestedBy: "admin",
          }),
        });
        publishStatus.textContent = "已加入队列，后续由 Agent 领取执行";
        publishForm.reset();
        await load();
      } catch (error) {
        publishStatus.textContent = error.message;
      }
    });

    refreshAuth().catch(() => {
      loginForm.hidden = false;
      admin.hidden = true;
    });
  </script>
</AdminLayout>
