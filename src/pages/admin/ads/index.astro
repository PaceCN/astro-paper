---
import AdminLayout from "@/layouts/AdminLayout.astro";

const fallbackSlots = [
  {
    slot_key: "pageTop",
    placement: "页首",
    enabled: 0,
    notes: "页面顶部广告开关",
  },
  {
    slot_key: "pageMiddle",
    placement: "页中",
    enabled: 0,
    notes: "正文或列表中部广告开关",
  },
  {
    slot_key: "pageBottom",
    placement: "页尾",
    enabled: 0,
    notes: "页面底部广告开关",
  },
  {
    slot_key: "leftRail",
    placement: "左侧",
    enabled: 0,
    notes: "桌面端左侧广告开关",
  },
  {
    slot_key: "rightRail",
    placement: "右侧",
    enabled: 0,
    notes: "桌面端右侧广告开关",
  },
];
---

<AdminLayout title="广告位管理">
  <div id="ads-admin" data-fallback={JSON.stringify(fallbackSlots)}>
    <form
      data-login
      class="not-prose max-w-md rounded-lg border border-border p-4"
      hidden
    >
      <label class="block text-sm font-semibold" for="ads-admin-password"
        >后台密码</label
      >
      <input
        id="ads-admin-password"
        name="password"
        type="password"
        class="mt-2 w-full rounded border border-border bg-background px-3 py-2"
        required
      />
      <button
        class="mt-3 rounded bg-accent px-4 py-2 text-sm font-semibold text-white"
        type="submit">登录</button
      >
      <p data-login-error class="mt-2 text-sm text-red-600" hidden></p>
    </form>

    <div data-admin hidden>
      <p class="text-sm opacity-75">
        这里只控制 5
        个固定广告位置的开关：页首、页中、页尾、左侧、右侧。默认全部关闭，避免出现满屏广告。
      </p>
      <p data-status class="mt-2 text-sm opacity-75">读取 BLOG_DB 广告位...</p>
      <div data-slots class="not-prose mt-4 grid gap-4"></div>
    </div>
  </div>

  <script is:inline>
    const root = document.querySelector("#ads-admin");
    const fallback = JSON.parse(root?.getAttribute("data-fallback") || "[]");
    const loginForm = root?.querySelector("[data-login]");
    const admin = root?.querySelector("[data-admin]");
    const slotsEl = root?.querySelector("[data-slots]");
    const status = root?.querySelector("[data-status]");
    const loginError = root?.querySelector("[data-login-error]");

    const api = async (path, options = {}) => {
      const response = await fetch(`/api/admin/${path}`, {
        credentials: "same-origin",
        headers: {
          "content-type": "application/json",
          ...(options.headers || {}),
        },
        ...options,
      });
      const data = await response.json();
      if (!response.ok)
        throw new Error(data.error || `API failed: ${response.status}`);
      return data;
    };

    const fieldClasses =
      "mt-1 w-full rounded border border-border bg-background px-3 py-2";

    const el = (tag, attrs = {}, children = []) => {
      const node = document.createElement(tag);
      Object.entries(attrs).forEach(([key, value]) => {
        if (key === "class") node.className = value;
        else if (key === "text") node.textContent = value;
        else if (key === "checked") node.checked = Boolean(value);
        else if (key === "dataset") Object.assign(node.dataset, value);
        else node.setAttribute(key, value);
      });
      children.forEach(child => node.append(child));
      return node;
    };

    const makeInputLabel = (text, name, value = "", placeholder = "") => {
      const input = el("input", { name, class: fieldClasses, placeholder });
      input.value = value || "";
      return el("label", { class: "block text-sm", text }, [input]);
    };

    const render = slots => {
      slotsEl.replaceChildren();
      slots.forEach(slot => {
        const form = el("form", {
          class:
            "grid gap-3 rounded-lg border border-border p-4 sm:grid-cols-2",
          dataset: { slot: slot.slot_key },
        });
        const title = el("h2", { class: "sm:col-span-2" }, [
          document.createTextNode(slot.placement || slot.slot_key),
          document.createTextNode(" "),
          el("code", { text: slot.slot_key }),
        ]);
        const clientId = makeInputLabel(
          "AdSense Client ID（可空）",
          "clientId",
          slot.client_id,
          "ca-pub-xxxxxxxxxx"
        );
        const slotId = makeInputLabel(
          "AdSense Slot ID（可空）",
          "slotId",
          slot.slot_id,
          "纯数字"
        );
        const enabledInput = el("input", {
          name: "enabled",
          type: "checkbox",
          checked: Number(slot.enabled) === 1,
        });
        const enabled = el(
          "label",
          { class: "flex items-center gap-2 text-sm" },
          [enabledInput, document.createTextNode(" 启用这个位置")]
        );
        const notes = el("textarea", { name: "notes", class: fieldClasses });
        notes.value = slot.notes || "";
        const notesLabel = el(
          "label",
          {
            class: "block text-sm sm:col-span-2",
            text: "备注",
          },
          [notes]
        );
        const saveStatus = el("span", {
          class: "ml-3 text-sm",
          dataset: { saveStatus: "" },
        });
        const actions = el("div", { class: "sm:col-span-2" }, [
          el("button", {
            class:
              "rounded bg-accent px-4 py-2 text-sm font-semibold text-white",
            type: "submit",
            text: "保存开关",
          }),
          saveStatus,
        ]);

        form.append(title, clientId, slotId, enabled, notesLabel, actions);
        form.addEventListener("submit", async event => {
          event.preventDefault();
          saveStatus.textContent = "保存中...";
          try {
            await api(`ads/${encodeURIComponent(form.dataset.slot)}`, {
              method: "PUT",
              body: JSON.stringify({
                clientId: form.clientId.value,
                slotId: form.slotId.value,
                enabled: form.enabled.checked,
                placement: slot.placement,
                notes: form.notes.value,
              }),
            });
            saveStatus.textContent = "已保存";
          } catch (error) {
            saveStatus.textContent = error.message;
          }
        });
        slotsEl.append(form);
      });
    };

    const load = async () => {
      try {
        const data = await api("ads");
        render(data.slots);
        status.textContent = `已从 BLOG_DB 读取 ${data.slots.length} 个广告位。`;
      } catch (error) {
        render(fallback);
        status.textContent = `D1 暂不可用，显示本地只读 fallback：${error.message}`;
      }
    };

    const refreshAuth = async () => {
      const me = await api("me");
      if (me.authenticated) {
        loginForm.hidden = true;
        admin.hidden = false;
        await load();
      } else {
        loginForm.hidden = false;
        admin.hidden = true;
      }
    };

    loginForm?.addEventListener("submit", async event => {
      event.preventDefault();
      loginError.hidden = true;
      try {
        await api("login", {
          method: "POST",
          body: JSON.stringify({ password: loginForm.password.value }),
        });
        loginForm.password.value = "";
        await refreshAuth();
      } catch (error) {
        loginError.textContent = error.message;
        loginError.hidden = false;
      }
    });

    refreshAuth().catch(() => {
      loginForm.hidden = false;
      admin.hidden = true;
    });
  </script>
</AdminLayout>
