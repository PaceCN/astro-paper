---
import AdminLayout from "@/layouts/AdminLayout.astro";

const fallbackSlots = [
  {
    slot_key: "homeAfterHero",
    placement: "首页介绍后",
    enabled: 0,
    client_id: "",
    slot_id: "",
    notes: "首页介绍区下方广告位，可作为首页首个低干扰广告位。",
  },
  {
    slot_key: "homeAfterRecent",
    placement: "首页最近文章后",
    enabled: 0,
    client_id: "",
    slot_id: "",
    notes: "首页最近文章列表后方广告位。",
  },
  {
    slot_key: "postTop",
    placement: "文章顶部",
    enabled: 0,
    client_id: "",
    slot_id: "",
    notes: "文章标题附近广告位，默认建议关闭，避免首屏体验变差。",
  },
  {
    slot_key: "postMiddle",
    placement: "文章中部",
    enabled: 0,
    client_id: "",
    slot_id: "",
    notes: "长文章中段广告位，默认建议关闭，确认体验后再启用。",
  },
  {
    slot_key: "postBottom",
    placement: "文章底部",
    enabled: 0,
    client_id: "",
    slot_id: "",
    notes: "文章结尾后的广告位，优先建议从这里开始启用。",
  },
  {
    slot_key: "leftRail",
    placement: "桌面左侧栏",
    enabled: 0,
    client_id: "",
    slot_id: "",
    notes: "桌面端左侧栏广告位；当前前台组件未默认渲染。",
  },
  {
    slot_key: "rightRail",
    placement: "桌面右侧栏",
    enabled: 0,
    client_id: "",
    slot_id: "",
    notes: "桌面端右侧栏广告位；当前前台组件未默认渲染。",
  },
];
---

<AdminLayout
  title="Google 广告 / AdSense"
  description="手动初始化、配置、保存和核对固定 Google AdSense 广告位。"
>
  <div
    id="ads-admin"
    class="admin-grid"
    data-fallback={JSON.stringify(fallbackSlots)}
  >
    <section class="admin-login-card" data-login-card hidden>
      <h2>需要后台密码</h2>
      <p class="admin-muted">登录后才能读取和保存 Google 广告位配置。</p>
      <form data-login class="admin-grid">
        <label class="admin-field" for="ads-admin-password">
          后台密码
          <input
            id="ads-admin-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
        </label>
        <button class="admin-btn admin-btn-primary" type="submit"
          >登录后台</button
        >
        <p data-login-error hidden></p>
      </form>
    </section>

    <div data-admin hidden class="admin-grid">
      <section class="admin-grid admin-grid-4" aria-label="广告统计">
        <article class="admin-card admin-stat">
          <strong>总广告位数</strong>
          <span data-total-slots>-</span>
          <p>固定 slot key，避免随意新增</p>
        </article>
        <article class="admin-card admin-stat">
          <strong>已启用</strong>
          <span data-enabled-slots>-</span>
          <p>启用但缺 ID 会提示</p>
        </article>
        <article class="admin-card admin-stat">
          <strong>Client ID 已填</strong>
          <span data-client-count>-</span>
          <p>格式 ca-pub-...</p>
        </article>
        <article class="admin-card admin-stat">
          <strong>Slot ID 已填</strong>
          <span data-slot-id-count>-</span>
          <p>纯数字广告单元 ID</p>
        </article>
      </section>

      <section class="admin-card">
        <div class="admin-card-header">
          <div>
            <h2>快速动作</h2>
            <p>先初始化固定广告位，再逐张卡填写 Client ID / Slot ID 并保存。</p>
          </div>
          <div class="admin-actions">
            <button
              class="admin-btn admin-btn-primary"
              type="button"
              data-init-slots
            >
              初始化固定广告位
            </button>
            <button
              class="admin-btn admin-btn-secondary"
              type="button"
              data-refresh-slots
            >
              刷新广告位
            </button>
          </div>
        </div>
        <p data-status hidden></p>
      </section>

      <section
        class="admin-grid admin-grid-2"
        data-slots
        aria-label="广告位编辑卡片"
      >
      </section>

      <section class="admin-card">
        <div class="admin-card-header">
          <div>
            <h2>Google 广告手动操作说明</h2>
            <p>
              这里保存后台配置，但当前前台广告组件仍读取 <code
                >src/config.ts</code
              > 的静态 ADS 配置。
            </p>
          </div>
        </div>
        <ol class="admin-muted" style="margin: 0; padding-left: 1.25rem;">
          <li>
            在 Google AdSense 后台复制 <code>ca-pub-...</code> 到 Client ID。
          </li>
          <li>从广告单元复制纯数字 Slot ID，填入对应广告位。</li>
          <li>
            建议先只启用 <code>postBottom</code> 或页尾相关位置，不要在首屏堆广告。
          </li>
          <li>
            保存到 D1 后，若要前台立即渲染真实广告，仍需同步/改造静态 <code
              >src/config.ts</code
            > 或让前台读取 D1，再重新构建部署。
          </li>
        </ol>
      </section>
    </div>
  </div>

  <script is:inline>
    const root = document.querySelector("#ads-admin");
    const { api, badge, escapeHtml, setStatus, setText } = window.PaceAdmin;
    const slotsEl = root?.querySelector("[data-slots]");
    const status = root?.querySelector("[data-status]");
    const fallback = JSON.parse(root?.getAttribute("data-fallback") || "[]");

    const slotLabels = {
      homeAfterHero: "首页介绍后",
      homeAfterRecent: "首页最近文章后",
      postTop: "文章顶部",
      postMiddle: "文章中部",
      postBottom: "文章底部",
      leftRail: "桌面左侧栏",
      rightRail: "桌面右侧栏",
    };

    const updateStats = slots => {
      setText(root, "[data-total-slots]", slots.length);
      setText(
        root,
        "[data-enabled-slots]",
        slots.filter(slot => Number(slot.enabled) === 1).length
      );
      setText(
        root,
        "[data-client-count]",
        slots.filter(slot => slot.client_id).length
      );
      setText(
        root,
        "[data-slot-id-count]",
        slots.filter(slot => slot.slot_id).length
      );
    };

    const slotPayload = form => ({
      clientId: form.clientId.value,
      slotId: form.slotId.value,
      enabled: form.enabled.checked,
      placement: form.placement.value,
      notes: form.notes.value,
    });

    const configText = (slotKey, payload) =>
      JSON.stringify(
        {
          slot_key: slotKey,
          provider: "google-adsense",
          client_id: payload.clientId,
          slot_id: payload.slotId,
          enabled: payload.enabled,
          placement: payload.placement,
          notes: payload.notes,
        },
        null,
        2
      );

    const renderSlots = slots => {
      updateStats(slots);
      slotsEl.replaceChildren();
      slots.forEach(slot => {
        const card = document.createElement("article");
        card.className = "admin-card";
        const enabled = Number(slot.enabled) === 1;
        const missingConfig = enabled && (!slot.client_id || !slot.slot_id);
        card.innerHTML = `
          <div class="admin-card-header">
            <div>
              <h2>${escapeHtml(slot.placement || slotLabels[slot.slot_key] || slot.slot_key)}</h2>
              <p>${badge(enabled ? "enabled" : "disabled", enabled ? "启用" : "暂停")} <code>${escapeHtml(slot.slot_key)}</code></p>
            </div>
          </div>
          <form class="admin-grid" data-slot-form data-slot="${escapeHtml(slot.slot_key)}">
            <label class="admin-switch">
              <input name="enabled" type="checkbox" ${enabled ? "checked" : ""} />
              <span data-enabled-label>${enabled ? "启用这个广告位" : "暂停这个广告位"}</span>
            </label>
            <label class="admin-field">
              Google AdSense Client ID
              <input name="clientId" placeholder="ca-pub-xxxxxxxxxxxxxxxx" value="${escapeHtml(slot.client_id || "")}" />
            </label>
            <label class="admin-field">
              Google AdSense Slot ID
              <input name="slotId" placeholder="1234567890" value="${escapeHtml(slot.slot_id || "")}" inputmode="numeric" />
            </label>
            <label class="admin-field">
              展示位置 placement
              <input name="placement" value="${escapeHtml(slot.placement || slotLabels[slot.slot_key] || "")}" />
            </label>
            <label class="admin-field">
              备注 notes
              <textarea name="notes">${escapeHtml(slot.notes || "")}</textarea>
            </label>
            <p class="admin-message admin-message-warning" data-warning ${missingConfig ? "" : "hidden"}>启用前请补齐 Client ID 和 Slot ID。</p>
            <div class="admin-actions">
              <button class="admin-btn admin-btn-primary" type="submit">保存这个广告位</button>
              <button class="admin-btn admin-btn-secondary" type="button" data-copy-config>复制配置</button>
              <button class="admin-btn admin-btn-subtle" type="button" data-clear-card>清空本卡输入</button>
            </div>
            <p data-save-status hidden></p>
          </form>
        `;
        const form = card.querySelector("[data-slot-form]");
        const saveStatus = card.querySelector("[data-save-status]");
        const warning = card.querySelector("[data-warning]");
        const enabledLabel = card.querySelector("[data-enabled-label]");

        const refreshWarning = () => {
          const missing =
            form.enabled.checked &&
            (!form.clientId.value.trim() || !form.slotId.value.trim());
          warning.hidden = !missing;
          enabledLabel.textContent = form.enabled.checked
            ? "启用这个广告位"
            : "暂停这个广告位";
        };

        form.enabled.addEventListener("change", refreshWarning);
        form.clientId.addEventListener("input", refreshWarning);
        form.slotId.addEventListener("input", refreshWarning);

        form.addEventListener("submit", async event => {
          event.preventDefault();
          setStatus(saveStatus, "保存中...", "muted");
          try {
            const payload = slotPayload(form);
            await api(`ads/${encodeURIComponent(form.dataset.slot)}`, {
              method: "PUT",
              body: JSON.stringify(payload),
            });
            setStatus(saveStatus, "已保存这个广告位。", "success");
            await loadSlots();
          } catch (error) {
            setStatus(saveStatus, `保存失败：${error.message}`, "danger");
          }
        });

        card
          .querySelector("[data-copy-config]")
          .addEventListener("click", async () => {
            const text = configText(form.dataset.slot, slotPayload(form));
            try {
              await navigator.clipboard.writeText(text);
              setStatus(saveStatus, "配置已复制到剪贴板。", "success");
            } catch {
              setStatus(saveStatus, text, "muted");
            }
          });

        card
          .querySelector("[data-clear-card]")
          .addEventListener("click", () => {
            form.clientId.value = "";
            form.slotId.value = "";
            form.placement.value =
              slot.placement || slotLabels[slot.slot_key] || "";
            form.notes.value = "";
            form.enabled.checked = false;
            refreshWarning();
            setStatus(saveStatus, "已清空本卡输入，未调用 API。", "muted");
          });

        slotsEl.append(card);
      });
    };

    const loadSlots = async () => {
      setStatus(status, "读取 BLOG_DB 广告位...", "muted");
      try {
        const data = await api("ads");
        renderSlots(data.slots || []);
        setStatus(
          status,
          `已从 BLOG_DB 读取 ${data.slots?.length || 0} 个广告位。`,
          "success"
        );
      } catch (error) {
        renderSlots(fallback);
        setStatus(
          status,
          `D1 暂不可用，显示本地 fallback，无法保存：${error.message}。请确认 BLOG_DB binding 与 schema 已配置。`,
          "danger"
        );
      }
    };

    root
      ?.querySelector("[data-refresh-slots]")
      ?.addEventListener("click", loadSlots);
    root
      ?.querySelector("[data-init-slots]")
      ?.addEventListener("click", async event => {
        const button = event.currentTarget;
        button.disabled = true;
        setStatus(status, "初始化固定广告位中...", "muted");
        try {
          await api("ads/slots", { method: "POST" });
          setStatus(status, "固定广告位已初始化。", "success");
          await loadSlots();
        } catch (error) {
          setStatus(status, `初始化失败：${error.message}`, "danger");
        } finally {
          button.disabled = false;
        }
      });

    window.PaceAdmin.initPage(root, loadSlots);
  </script>
</AdminLayout>
