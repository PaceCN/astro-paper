---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { ADS } from "@/config";

const fallbackSlots = Object.entries(ADS.slots).map(([slot_key, slot]) => ({
  slot_key,
  provider: ADS.provider,
  client_id: ADS.googleClient,
  slot_id: slot.slot,
  enabled: slot.enabled ? 1 : 0,
  placement: slot.label,
  notes: "来自 src/config.ts 的只读 fallback",
}));
---

<AdminLayout title="广告位管理">
  <div id="ads-admin" data-fallback={JSON.stringify(fallbackSlots)}>
    <form
      data-login
      class="not-prose max-w-md rounded-lg border border-border p-4"
      hidden
    >
      <label class="block text-sm font-semibold" for="ads-admin-password"
        >后台密码</label
      >
      <input
        id="ads-admin-password"
        name="password"
        type="password"
        class="mt-2 w-full rounded border border-border bg-background px-3 py-2"
        required
      />
      <button
        class="mt-3 rounded bg-accent px-4 py-2 text-sm font-semibold text-white"
        type="submit">登录</button
      >
      <p data-login-error class="mt-2 text-sm text-red-600" hidden></p>
    </form>

    <div data-admin hidden>
      <p data-status class="text-sm opacity-75">读取 BLOG_DB 广告位...</p>
      <div data-slots class="not-prose grid gap-4"></div>
    </div>
  </div>

  <script is:inline>
    const root = document.querySelector("#ads-admin");
    const fallback = JSON.parse(root?.getAttribute("data-fallback") || "[]");
    const loginForm = root?.querySelector("[data-login]");
    const admin = root?.querySelector("[data-admin]");
    const slotsEl = root?.querySelector("[data-slots]");
    const status = root?.querySelector("[data-status]");
    const loginError = root?.querySelector("[data-login-error]");

    const api = async (path, options = {}) => {
      const response = await fetch(`/api/admin/${path}`, {
        credentials: "same-origin",
        headers: {
          "content-type": "application/json",
          ...(options.headers || {}),
        },
        ...options,
      });
      const data = await response.json();
      if (!response.ok)
        throw new Error(data.error || `API failed: ${response.status}`);
      return data;
    };

    const render = slots => {
      slotsEl.innerHTML = slots
        .map(
          slot => `<form data-slot="${slot.slot_key}" class="grid gap-3 rounded-lg border border-border p-4 sm:grid-cols-2">
            <h2 class="sm:col-span-2"><code>${slot.slot_key}</code></h2>
            <label class="block text-sm">Client ID<input name="clientId" value="${slot.client_id || ""}" class="mt-1 w-full rounded border border-border bg-background px-3 py-2" /></label>
            <label class="block text-sm">Slot ID<input name="slotId" value="${slot.slot_id || ""}" class="mt-1 w-full rounded border border-border bg-background px-3 py-2" /></label>
            <label class="block text-sm">位置<input name="placement" value="${slot.placement || ""}" class="mt-1 w-full rounded border border-border bg-background px-3 py-2" /></label>
            <label class="flex items-center gap-2 text-sm"><input name="enabled" type="checkbox" ${Number(slot.enabled) === 1 ? "checked" : ""} /> 启用</label>
            <label class="block text-sm sm:col-span-2">备注<textarea name="notes" class="mt-1 w-full rounded border border-border bg-background px-3 py-2">${slot.notes || ""}</textarea></label>
            <div class="sm:col-span-2"><button class="rounded bg-accent px-4 py-2 text-sm font-semibold text-white" type="submit">保存</button><span data-save-status class="ml-3 text-sm"></span></div>
          </form>`
        )
        .join("");

      slotsEl.querySelectorAll("form[data-slot]").forEach(form => {
        form.addEventListener("submit", async event => {
          event.preventDefault();
          const saveStatus = form.querySelector("[data-save-status]");
          saveStatus.textContent = "保存中...";
          try {
            await api(`ads/${encodeURIComponent(form.dataset.slot)}`, {
              method: "PUT",
              body: JSON.stringify({
                clientId: form.clientId.value,
                slotId: form.slotId.value,
                enabled: form.enabled.checked,
                placement: form.placement.value,
                notes: form.notes.value,
              }),
            });
            saveStatus.textContent = "已保存";
          } catch (error) {
            saveStatus.textContent = error.message;
          }
        });
      });
    };

    const load = async () => {
      try {
        const data = await api("ads");
        render(data.slots);
        status.textContent = `已从 BLOG_DB 读取 ${data.slots.length} 个广告位。`;
      } catch (error) {
        render(fallback);
        status.textContent = `D1 暂不可用，显示本地只读 fallback：${error.message}`;
      }
    };

    const refreshAuth = async () => {
      const me = await api("me");
      if (me.authenticated) {
        loginForm.hidden = true;
        admin.hidden = false;
        await load();
      } else {
        loginForm.hidden = false;
        admin.hidden = true;
      }
    };

    loginForm?.addEventListener("submit", async event => {
      event.preventDefault();
      loginError.hidden = true;
      try {
        await api("login", {
          method: "POST",
          body: JSON.stringify({ password: loginForm.password.value }),
        });
        loginForm.password.value = "";
        await refreshAuth();
      } catch (error) {
        loginError.textContent = error.message;
        loginError.hidden = false;
      }
    });

    refreshAuth().catch(() => {
      loginForm.hidden = false;
      admin.hidden = true;
    });
  </script>
</AdminLayout>
