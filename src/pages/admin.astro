---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/config';

const rawTab = Astro.url.searchParams.get('tab') || 'new';
const tab = ['new', 'posts', 'ads', 'docs'].includes(rawTab) ? rawTab : 'new';
const navItems = [
  ['new', '新建文章'],
  ['posts', '文章管理'],
  ['ads', '广告管理'],
  ['docs', '说明'],
] as const;
const adSlots = [
  ['header_bottom', '首页最新文章上方'],
  ['footer_top', '首页最新文章下方'],
  ['sidebar_top', '文章页竖版广告'],
  ['content_top', '文章页正文上方'],
  ['content_bottom', '文章页正文下方'],
] as const;
---

<Layout title={`后台 | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-8">
    <section class="border-b border-border pb-6">
      <p class="text-sm text-muted-foreground">站点后台</p>
      <h1 class="mt-2 text-3xl font-bold text-accent">内容管理</h1>
      <p class="mt-3 text-muted-foreground">维护 D1 里的文章、广告位，并查看自动化接口说明。</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="rounded border border-border px-3 py-2 hover:text-accent" href="/">返回首页</a>
        <button id="logout-button" class="rounded border border-border px-3 py-2 hover:text-accent" type="button">退出登录</button>
      </div>
    </section>

    <section class="grid gap-6 py-8 md:grid-cols-[180px_minmax(0,1fr)]">
      <aside class="md:sticky md:top-4 md:self-start">
        <nav class="grid gap-2 rounded border border-border p-2" aria-label="后台导航">
          {navItems.map(([key, label]) => (
            <a
              class:list={[
                'rounded px-3 py-2 text-left hover:text-accent',
                { 'bg-muted/60 text-accent': tab === key },
              ]}
              href={`/admin?tab=${key}`}
            >
              {label}
            </a>
          ))}
        </nav>
      </aside>

      <div class="min-w-0">
        {tab === 'new' && (
          <section class="rounded border border-border p-4">
            <h2 id="post-form-title" class="text-xl font-semibold">新建文章</h2>
            <p class="mt-2 text-sm text-muted-foreground">默认保存为隐藏，检查无误后可在文章管理里发布。</p>
            <form id="post-form" class="mt-4 space-y-4">
              <input name="id" type="hidden" />
              <label class="block">
                <span class="mb-1 block text-sm text-muted-foreground">标题</span>
                <input name="title" class="w-full rounded border border-border bg-background px-3 py-2" required />
              </label>
              <label class="block">
                <span class="mb-1 block text-sm text-muted-foreground">Slug</span>
                <input name="slug" class="w-full rounded border border-border bg-background px-3 py-2" placeholder="留空时由标题生成" />
              </label>
              <label class="block">
                <span class="mb-1 block text-sm text-muted-foreground">状态</span>
                <select name="status" class="w-full rounded border border-border bg-background px-3 py-2">
                  <option value="hidden">隐藏</option>
                  <option value="published">发布</option>
                </select>
              </label>
              <label class="block">
                <span class="mb-1 block text-sm text-muted-foreground">正文 Markdown</span>
                <textarea name="content" class="min-h-80 w-full rounded border border-border bg-background px-3 py-2 font-mono text-sm" required></textarea>
              </label>
              <div class="flex flex-wrap gap-3">
                <button class="rounded bg-accent px-4 py-2 text-background" type="submit">保存文章</button>
                <button id="reset-post-form" class="rounded border border-border px-4 py-2" type="button">清空</button>
              </div>
              <p id="post-form-message" class="text-sm text-muted-foreground"></p>
            </form>
          </section>
        )}

        {tab === 'posts' && (
          <section class="rounded border border-border p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-xl font-semibold">文章管理</h2>
                <p class="text-sm text-muted-foreground">编辑、发布、隐藏或删除文章。</p>
              </div>
              <a class="rounded bg-accent px-3 py-2 text-background" href="/admin?tab=new">新建文章</a>
            </div>
            <p id="posts-message" class="mt-4 text-sm text-muted-foreground">正在读取文章...</p>
            <ul id="posts-list" class="mt-4 space-y-3"></ul>
          </section>
        )}

        {tab === 'ads' && (
          <section class="rounded border border-border p-4">
            <h2 class="text-xl font-semibold">广告管理</h2>
            <p class="mt-2 text-sm text-muted-foreground">首页只使用“首页最新文章上方/下方”；文章详情页使用“文章页竖版广告/正文上方/正文下方”。不放广告时可以留空。</p>
            <div id="ads-list" class="mt-4 grid gap-4 md:grid-cols-2">
              {adSlots.map(([position, label]) => (
                <form class="rounded border border-border p-3" data-ad-form={position}>
                  <h3 class="font-semibold">{label}</h3>
                  <label class="mt-3 flex items-center gap-2 text-sm">
                    <input name="isEnabled" type="checkbox" />
                    启用
                  </label>
                  <label class="mt-3 block">
                    <span class="mb-1 block text-sm text-muted-foreground">广告代码</span>
                    <textarea name="adCode" class="min-h-28 w-full rounded border border-border bg-background px-3 py-2 font-mono text-xs"></textarea>
                  </label>
                  <button class="mt-3 rounded bg-accent px-3 py-2 text-sm text-background" type="submit">保存广告位</button>
                </form>
              ))}
            </div>
            <p id="ads-message" class="mt-4 text-sm text-muted-foreground">广告位表单已载入，正在读取已有配置...</p>
          </section>
        )}

        {tab === 'docs' && (
          <section class="rounded border border-border p-4">
            <h2 class="text-xl font-semibold text-accent">后台与 API 使用说明</h2>
            <div class="app-prose mt-4 max-w-none text-sm">
              <p><code>/api/ads</code> 和 <code>/api/posts</code> 是给后台、前台组件和自动化脚本调用的接口，不是普通页面。</p>
              <h3>/api/ads</h3>
              <p>用于读取和保存广告位配置。首页只展示首页广告位；文章详情页只展示文章页广告位，避免破坏原始居中阅读布局。</p>
              <pre><code>GET /api/ads</code></pre>
              <pre><code set:html={`PUT /api/ads/content_top
Content-Type: application/json

{
  &quot;adCode&quot;: &quot;&amp;lt;ins class=&amp;quot;adsbygoogle&amp;quot; ...&amp;gt;&amp;lt;/ins&amp;gt;&quot;,
  &quot;isEnabled&quot;: true
}`} /></pre>
              <h3>/api/posts</h3>
              <p>AI 或脚本可以先登录，再带 cookie 调用接口创建文章。建议默认保存为 <code>hidden</code>。</p>
              <pre><code set:html={`POST /api/auth/login
Content-Type: application/json

{
  &quot;password&quot;: &quot;你的 ADMIN_PASSWORD&quot;
}`} /></pre>
              <pre><code set:html={`POST /api/posts
Content-Type: application/json
Cookie: session=登录接口返回的 session cookie

{
  &quot;title&quot;: &quot;文章标题&quot;,
  &quot;slug&quot;: &quot;article-slug&quot;,
  &quot;status&quot;: &quot;hidden&quot;,
  &quot;content&quot;: &quot;# Markdown 正文\\n\\n这里写文章内容。&quot;
}`} /></pre>
              <ul>
                <li><code>GET /api/posts?status=published&amp;pageSize=20</code>：公开读取已发布文章。</li>
                <li><code>POST /api/posts</code>：登录后创建文章。</li>
                <li><code>PUT /api/posts/:id</code>：登录后更新文章。</li>
                <li><code>PATCH /api/posts/:id/status</code>：登录后发布或隐藏文章。</li>
                <li><code>DELETE /api/posts/:id</code>：登录后删除文章。</li>
              </ul>
            </div>
          </section>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script define:vars={{ tab }}>
  async function api(path, options = {}) {
    const response = await fetch(`/api/${path}`, {
      headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
      ...options,
    });
    const result = await response.json().catch(() => ({ success: false, message: '接口返回格式错误' }));
    if (!response.ok || !result.success) throw new Error(result.message || '请求失败');
    return result.data ?? result;
  }

  function setText(element, text) {
    if (element) element.textContent = text;
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function excerpt(content) {
    return String(content || '').replace(/[#>*_\[\]`-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 90);
  }

  document.querySelector('#logout-button')?.addEventListener('click', async () => {
    try {
      await api('auth/logout', { method: 'POST' });
    } finally {
      window.location.href = '/login';
    }
  });

  if (tab === 'new') {
    const form = document.querySelector('#post-form');
    const message = document.querySelector('#post-form-message');
    document.querySelector('#reset-post-form')?.addEventListener('click', () => {
      form?.reset();
      setText(message, '');
    });
    form?.addEventListener('submit', async event => {
      event.preventDefault();
      const payload = {
        title: form.title.value,
        slug: form.slug.value,
        status: form.status.value,
        content: form.content.value,
      };
      try {
        setText(message, '正在保存...');
        await api('posts', { method: 'POST', body: JSON.stringify(payload) });
        setText(message, '保存成功。可以到文章管理里查看。');
        form.reset();
      } catch (error) {
        setText(message, `保存失败：${error.message}`);
      }
    });
  }

  if (tab === 'posts') {
    const list = document.querySelector('#posts-list');
    const message = document.querySelector('#posts-message');
    async function loadPosts() {
      try {
        const data = await api('posts?pageSize=50');
        const posts = data.posts || [];
        list.innerHTML = posts.length ? posts.map(post => `
          <li class="rounded border border-border p-3">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 class="font-semibold">${escapeHtml(post.title)}</h3>
                <p class="text-sm text-muted-foreground">/${escapeHtml(post.slug)} · ${post.status === 'published' ? '已发布' : '隐藏'}</p>
                <p class="mt-2 text-sm">${escapeHtml(excerpt(post.content))}</p>
              </div>
              <div class="flex flex-wrap gap-2 text-sm">
                <button class="rounded border border-border px-2 py-1" data-toggle="${post.id}" data-status="${post.status === 'published' ? 'hidden' : 'published'}" type="button">${post.status === 'published' ? '隐藏' : '发布'}</button>
                <button class="rounded border border-border px-2 py-1 text-red-500" data-delete="${post.id}" type="button">删除</button>
              </div>
            </div>
          </li>
        `).join('') : '<li class="text-sm text-muted-foreground">还没有文章。</li>';
        setText(message, `已读取 ${posts.length} 篇文章。`);
      } catch (error) {
        setText(message, `读取文章失败：${error.message}`);
        if (String(error.message).includes('未登录')) window.location.href = '/login';
      }
    }
    list?.addEventListener('click', async event => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const toggleId = target.dataset.toggle;
      const deleteId = target.dataset.delete;
      if (toggleId) {
        await api(`posts/${toggleId}/status`, { method: 'PATCH', body: JSON.stringify({ status: target.dataset.status }) });
        await loadPosts();
      }
      if (deleteId && confirm('确定删除这篇文章吗？这个操作不能撤销。')) {
        await api(`posts/${deleteId}`, { method: 'DELETE' });
        await loadPosts();
      }
    });
    loadPosts();
  }

  if (tab === 'ads') {
    const list = document.querySelector('#ads-list');
    const message = document.querySelector('#ads-message');
    async function loadAds() {
      try {
        const data = await api('ads');
        const slots = data.adSlots || [];
        slots.forEach(slot => {
          const form = list?.querySelector(`[data-ad-form="${slot.position}"]`);
          if (!form) return;
          form.adCode.value = slot.adCode ?? slot.ad_code ?? '';
          form.isEnabled.checked = Boolean(slot.isEnabled ?? slot.is_enabled);
        });
        setText(message, `已读取 ${slots.length} 个广告位。`);
      } catch (error) {
        setText(message, `读取广告位失败：${error.message}。表单仍可填写并保存。`);
      }
    }
    list?.addEventListener('submit', async event => {
      event.preventDefault();
      const form = event.target;
      const position = form.dataset.adForm;
      try {
        await api(`ads/${position}`, {
          method: 'PUT',
          body: JSON.stringify({ adCode: form.adCode.value, isEnabled: form.isEnabled.checked }),
        });
        setText(message, '广告位已保存。');
        await loadAds();
      } catch (error) {
        setText(message, `保存失败：${error.message}`);
      }
    });
    loadAds();
  }
</script>
