---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

type Props = {
  title: string;
  description?: string;
};

const { title, description = "Pace Notes 后台管理。" } = Astro.props;
const adminBasePath = import.meta.env.PUBLIC_ADMIN_BASE_PATH || "/admin";
const normalizedAdminBasePath = adminBasePath.startsWith("/")
  ? adminBasePath
  : `/${adminBasePath}`;
const nav = [
  [normalizedAdminBasePath, "总览"],
  [`${normalizedAdminBasePath}/posts`, "文章"],
  [`${normalizedAdminBasePath}/ads`, "广告"],
  [`${normalizedAdminBasePath}/automation`, "自动化"],
];
---

<Layout title={`${title} | 后台 | ${SITE.title}`} description={description}>
  <Header />
  <main id="main-content" class="app-layout py-8">
    <div class="mb-6 rounded-lg border border-border bg-background p-4">
      <p class="text-sm font-semibold text-accent">Pace Notes 后台</p>
      <p class="mt-1 text-sm opacity-80">
        页面可以公开访问，但所有后台 API 读写都需要通过 <code
          >ADMIN_PASSWORD</code
        >
        登录后由 httpOnly cookie 认证。
      </p>
      <nav class="mt-4 flex flex-wrap gap-3 text-sm">
        {
          nav.map(([href, label]) => (
            <a href={href} class="hover:text-accent">
              {label}
            </a>
          ))
        }
      </nav>
      {
        normalizedAdminBasePath !== "/admin" && (
          <p class="mt-3 text-xs opacity-70">
            当前构建后台路径：<code>{normalizedAdminBasePath}</code>。Astro
            静态路由需要重新部署后生效。
          </p>
        )
      }
    </div>
    <section class="app-prose max-w-none">
      <h1>{title}</h1>
      <slot />
    </section>
  </main>
  <Footer />
</Layout>
