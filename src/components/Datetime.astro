---
import IconCalendar from '@/assets/icons/IconCalendar.svg';
import { SITE } from '@/config';

type Props = {
  class?: string;
  size?: 'sm' | 'lg';
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = 'sm',
  class: className = '',
  timezone: postTimezone,
} = Astro.props;

const displayTimezone = postTimezone || SITE.timezone;
const publishedDatetime = new Date(pubDatetime);
const modifiedDatetime = modDatetime ? new Date(modDatetime) : null;
const isModified = modifiedDatetime && modifiedDatetime > publishedDatetime;
const formatter = new Intl.DateTimeFormat('zh-CN', {
  timeZone: displayTimezone,
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const date = formatter.format(publishedDatetime);
const modifiedDate = modifiedDatetime ? formatter.format(modifiedDatetime) : '';
---

<div class:list={['flex items-center gap-x-2 opacity-80', className]}>
  <IconCalendar
    class:list={[
      'inline-block size-6 min-w-5.5',
      { 'scale-90': size === 'sm' },
    ]}
  />
  <span class:list={['text-sm', { 'sm:text-base': size === 'lg' }]}>发布：</span>
  <time
    class:list={['text-sm', { 'sm:text-base': size === 'lg' }]}
    datetime={publishedDatetime.toISOString()}>{date}</time
  >
  {
    isModified && modifiedDatetime && (
      <>
        <span class:list={['text-sm', { 'sm:text-base': size === 'lg' }]}>更新：</span>
        <time
          class:list={['text-sm', { 'sm:text-base': size === 'lg' }]}
          datetime={modifiedDatetime.toISOString()}
        >
          {modifiedDate}
        </time>
      </>
    )
  }
</div>
