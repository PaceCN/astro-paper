---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header class="app-layout py-4">
  <div id="top-nav-wrap" class="surface-card relative flex items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="text-lg font-semibold tracking-tight text-foreground hover:text-accent sm:text-xl">
      {SITE.title}
    </a>
    <nav id="nav-menu" class="flex items-center gap-2">
      <button
        id="menu-btn"
        class="focus-outline rounded-full p-2 sm:hidden"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class:list={[
          "absolute left-4 right-4 top-[calc(100%+0.5rem)] z-40 hidden rounded-3xl border border-border bg-card p-3 shadow-[var(--shadow)]",
          "sm:static sm:z-auto sm:flex sm:items-center sm:gap-1 sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none",
          "[&>li>a]:block [&>li>a]:rounded-full [&>li>a]:px-4 [&>li>a]:py-2 [&>li>a]:text-sm [&>li>a]:font-medium [&>li>a]:text-subtle [&>li>a]:hover:text-accent",
        ]}
      >
        <li><a href="/" class:list={{ "active-nav": currentPath === "/" }}>首页</a></li>
        <li><a href="/archive/" class:list={{ "active-nav": isActive("/archive") || isActive("/posts") }}>归档</a></li>
        <li>
          <button
            id="search-open-btn"
            type="button"
            class="focus-outline flex items-center justify-center rounded-full px-4 py-2 text-sm font-medium text-subtle hover:text-accent hover:[&>svg]:stroke-accent"
            title="搜索"
            aria-label="搜索"
            aria-haspopup="dialog"
          >
            <IconSearch />
            <span class="ms-2 text-sm sm:sr-only">搜索</span>
          </button>
        </li>
        {SITE.lightAndDarkMode && (
          <li class="flex items-center justify-center">
            <button
              id="theme-btn"
              class="focus-outline relative size-10 rounded-full p-3 hover:bg-accent/10 hover:[&>svg]:stroke-accent"
              title="切换主题"
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          </li>
        )}
      </ul>
    </nav>
  </div>
</header>

<div
  id="search-dialog"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-foreground/20 px-4 py-24 backdrop-blur-sm sm:py-28"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-dialog-title"
>
  <div id="search-panel" class="w-full max-w-2xl rounded-3xl border border-border bg-card p-4 shadow-[var(--shadow)] sm:p-5">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 id="search-dialog-title" class="text-base font-semibold text-foreground">搜索文章</h2>
      <button
        id="search-close-btn"
        type="button"
        class="focus-outline rounded-full p-2 text-subtle hover:bg-accent/10 hover:text-accent"
        aria-label="关闭搜索"
      >
        <IconX aria-hidden="true" />
      </button>
    </div>
    <form id="search-form" class="flex gap-2">
      <input
        id="search-input"
        class="min-w-0 flex-1 rounded-full border border-border bg-background px-4 py-2 text-sm text-foreground outline-none focus:border-accent"
        type="search"
        autocomplete="off"
        placeholder="输入关键词"
      />
      <button
        type="submit"
        class="focus-outline flex size-10 shrink-0 items-center justify-center rounded-full bg-accent text-background hover:opacity-90"
        aria-label="提交搜索"
      >
        <IconSearch aria-hidden="true" />
      </button>
    </form>
    <p id="search-status" class="mt-3 min-h-5 text-sm text-subtle" aria-live="polite"></p>
    <ul id="search-results" class="mt-3 max-h-[55vh] space-y-2 overflow-y-auto"></ul>
  </div>
</div>

<script>
  function initHeaderControls() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (
      menuBtn instanceof HTMLButtonElement &&
      menuItems instanceof HTMLElement &&
      menuIcon instanceof Element &&
      closeIcon instanceof Element &&
      menuBtn.dataset.bound !== "true"
    ) {
      menuBtn.dataset.bound = "true";
      menuBtn.addEventListener("click", () => {
        const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

        menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
        menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

        menuItems.classList.toggle("hidden");
        menuIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      });
    }

    const openBtn = document.querySelector("#search-open-btn");
    const dialog = document.querySelector("#search-dialog");
    const panel = document.querySelector("#search-panel");
    const closeBtn = document.querySelector("#search-close-btn");
    const form = document.querySelector("#search-form");
    const input = document.querySelector("#search-input");
    const status = document.querySelector("#search-status");
    const results = document.querySelector("#search-results");

    if (
      !(openBtn instanceof HTMLButtonElement) ||
      !(dialog instanceof HTMLElement) ||
      !(panel instanceof HTMLElement) ||
      !(closeBtn instanceof HTMLButtonElement) ||
      !(form instanceof HTMLFormElement) ||
      !(input instanceof HTMLInputElement) ||
      !(status instanceof HTMLElement) ||
      !(results instanceof HTMLUListElement) ||
      openBtn.dataset.bound === "true"
    ) {
      return;
    }

    const cooldownMs = 30_000;
    const cooldownKey = "blog-search-last-at";

    function setStatus(message: string) {
      status.textContent = message;
    }

    function clearResults() {
      results.replaceChildren();
    }

    function openSearch() {
      dialog.classList.remove("hidden");
      dialog.classList.add("flex");
      window.setTimeout(() => input.focus(), 0);
    }

    function closeSearch() {
      dialog.classList.add("hidden");
      dialog.classList.remove("flex");
      openBtn.focus();
    }

    function cooldownLeft() {
      const lastSearchAt = Number(localStorage.getItem(cooldownKey) || 0);
      return Math.max(0, lastSearchAt + cooldownMs - Date.now());
    }

    function resultUrl(slug: string) {
      return `/posts/${encodeURIComponent(slug)}/`;
    }

    openBtn.dataset.bound = "true";
    openBtn.addEventListener("click", openSearch);
    closeBtn.addEventListener("click", closeSearch);
    dialog.addEventListener("click", (event: MouseEvent) => {
      if (event.target === dialog) closeSearch();
    });
    document.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape" && !dialog.classList.contains("hidden")) closeSearch();
    });

    form.addEventListener("submit", async (event: SubmitEvent) => {
      event.preventDefault();
      const query = input.value.trim().replace(/\s+/g, " ");
      clearResults();

      if (query.length < 2) {
        setStatus("请输入至少 2 个字符。");
        return;
      }

      const waitMs = cooldownLeft();
      if (waitMs > 0) {
        setStatus(`请 ${Math.ceil(waitMs / 1000)} 秒后再搜索。`);
        return;
      }

      localStorage.setItem(cooldownKey, String(Date.now()));
      setStatus("搜索中...");

      try {
        const response = await fetch("/api/search", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query }),
        });
        const payload = await response.json();

        if (!response.ok || !payload.success) {
          throw new Error(payload.message || "搜索失败，请稍后再试。");
        }

        const posts = Array.isArray(payload.data?.posts) ? payload.data.posts : [];
        if (!posts.length) {
          setStatus("没有找到匹配文章。");
          return;
        }

        const fragment = document.createDocumentFragment();
        posts.forEach((post: unknown) => {
          if (!post || typeof post !== "object") return;
          const itemData = post as { title?: unknown; slug?: unknown };
          if (typeof itemData.title !== "string" || typeof itemData.slug !== "string") return;

          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = resultUrl(itemData.slug);
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.className = "block rounded-2xl border border-border bg-card-muted px-4 py-3 text-sm font-medium text-foreground hover:border-accent/50 hover:text-accent";
          link.textContent = itemData.title;
          item.append(link);
          fragment.append(item);
        });

        results.append(fragment);
        setStatus(`找到 ${posts.length} 篇文章。`);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : "搜索失败，请稍后再试。");
      }
    });
  }

  initHeaderControls();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", initHeaderControls);
</script>
