---
import type { AdPosition } from '../db/schema';

type AstroPaperSlot = 'homeAfterHero' | 'homeAfterRecent' | 'postTop' | 'postMiddle' | 'postBottom';
type SlotName = AstroPaperSlot | AdPosition;
type AdSlot = {
  position: AdPosition;
  adCode: string;
  isEnabled: boolean;
};

type Props = {
  slot?: SlotName;
  position?: AdPosition;
  class?: string;
};

const slotPositionMap: Record<AstroPaperSlot, AdPosition> = {
  homeAfterHero: 'content_top',
  homeAfterRecent: 'content_bottom',
  postTop: 'content_top',
  postMiddle: 'content_bottom',
  postBottom: 'content_bottom'
};

const { slot, position, class: className = '' } = Astro.props as Props;
const requestedSlot = slot ?? position ?? 'content_bottom';
const adPosition = requestedSlot in slotPositionMap ? slotPositionMap[requestedSlot as AstroPaperSlot] : requestedSlot as AdPosition;
let adSlot: AdSlot | undefined;

try {
  const response = await fetch(new URL('/api/ads', Astro.url));
  const result = await response.json() as { success: boolean; data?: { adSlots: AdSlot[] } };
  adSlot = result.data?.adSlots.find((item) => item.position === adPosition);
} catch {
  adSlot = undefined;
}
---

{adSlot?.isEnabled && adSlot.adCode ? (
  <aside class:list={["my-8 text-center text-sm text-muted-foreground", className]} data-ad-position={adPosition} set:html={adSlot.adCode} />
) : null}
