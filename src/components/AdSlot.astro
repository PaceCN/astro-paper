---
import type { AdPosition } from '../db/schema';

type AdSlot = {
  position: AdPosition;
  adCode: string;
  isEnabled: boolean;
};

const { position } = Astro.props as { position: AdPosition };
let slot: AdSlot | undefined;

try {
  const response = await fetch(new URL('/api/ads', Astro.url));
  const result = await response.json() as { success: boolean; data?: { adSlots: AdSlot[] } };
  slot = result.data?.adSlots.find((item) => item.position === position);
} catch {
  slot = undefined;
}
---

{slot?.isEnabled && slot.adCode ? (
  <aside class="my-8 text-center text-sm text-neutral-500" data-ad-position={position} set:html={slot.adCode} />
) : null}
