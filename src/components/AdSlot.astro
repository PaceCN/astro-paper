---
import type { AdPosition } from '../db/schema';

type AstroPaperSlot = 'homeAfterHero' | 'homeAfterRecent' | 'postTop' | 'postMiddle' | 'postBottom';
type SlotName = AstroPaperSlot | AdPosition;
type AdSlot = {
  position: AdPosition;
  adCode?: string;
  ad_code?: string;
  isEnabled?: boolean;
  is_enabled?: boolean;
};

type Props = {
  slot?: SlotName;
  position?: AdPosition;
  class?: string;
  adSlots?: AdSlot[];
};

const slotPositionMap: Record<AstroPaperSlot, AdPosition> = {
  homeAfterHero: 'header_bottom',
  homeAfterRecent: 'footer_top',
  postTop: 'content_top',
  postMiddle: 'content_bottom',
  postBottom: 'content_bottom'
};

const { slot, position, class: className = '', adSlots = [] } = Astro.props as Props;
const requestedSlot = slot ?? position ?? 'content_bottom';
const adPosition = requestedSlot in slotPositionMap ? slotPositionMap[requestedSlot as AstroPaperSlot] : requestedSlot as AdPosition;
const adSlot = adSlots.find((item) => item.position === adPosition);

const adCode = (adSlot?.adCode ?? adSlot?.ad_code ?? '').trim();
const isEnabled = Boolean(adSlot?.isEnabled ?? adSlot?.is_enabled);
const isImageUrl = /^https?:\/\/[^\s<>]+\.(png|jpe?g|gif|webp|svg)(\?[^\s<>]*)?$/i.test(adCode);
---

{isEnabled && adCode ? (
  <aside class:list={["ad-slot my-8", className]} data-ad-position={adPosition} aria-label="广告">
    <div class="ad-content">
      {isImageUrl ? (
        <img src={adCode} alt="广告" loading="lazy" />
      ) : (
        <Fragment set:html={adCode} />
      )}
    </div>
  </aside>
) : null}
