---
import Datetime from './Datetime.astro';

type Post = {
  title: string;
  slug: string;
  content?: string;
  description?: string;
  createdAt?: string | number | Date;
  updatedAt?: string | number | Date;
  tags?: string;
  category?: string;
  featured?: boolean;
};

type Props = {
  post: Post;
  compact?: boolean;
  tagsEnabled?: boolean;
};

const { post, compact = false, tagsEnabled = true } = Astro.props;
const tags = String(post.tags || '').split(',').map(tag => tag.trim()).filter(Boolean).slice(0, compact ? 2 : 4);
const description = post.description || String(post.content || '').replace(/[#>*_\[\]`-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 150);
const date = post.createdAt ? new Date(post.createdAt) : new Date();
---

<a href={`/posts/${post.slug}/`} class:list={['soft-card group block overflow-hidden p-5', { 'p-4': compact }]}>
  <article class="space-y-3">
    <div class="flex flex-wrap items-center gap-2 text-xs text-subtle">
      <span class="chip border-accent/30 text-accent">{post.category || '随笔'}</span>
      {post.featured && <span class="chip">推荐</span>}
    </div>
    <h2 class:list={['font-semibold leading-snug text-foreground group-hover:text-accent', compact ? 'text-base' : 'text-xl']}>
      {post.title}
    </h2>
    {description && <p class:list={['text-subtle', compact ? 'line-clamp-2 text-sm' : 'line-clamp-3 text-sm leading-6']}>{description}</p>}
    <div class="flex flex-wrap items-center justify-between gap-3">
      <Datetime pubDatetime={date} class="text-subtle" />
      {tagsEnabled && tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => <span class="chip">#{tag}</span>)}
        </div>
      )}
    </div>
  </article>
</a>
