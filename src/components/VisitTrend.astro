---
type Visit = { date: string; count: number };
type Props = { visits: Visit[] };
const { visits } = Astro.props;
const max = Math.max(1, ...visits.map(item => item.count));
const chartPoints = visits.map((item, index) => {
  const x = visits.length <= 1 ? 0 : (index / (visits.length - 1)) * 100;
  const y = 48 - (item.count / max) * 42;
  return { ...item, x, y };
});
const points = chartPoints.map(point => `${point.x.toFixed(2)},${point.y.toFixed(2)}`).join(' ');
const total = visits.reduce((sum, item) => sum + item.count, 0);
---

<section class="surface-card p-5">
  <div class="mb-4 flex items-start justify-between gap-3">
    <div>
      <h3 class="font-semibold">访问趋势</h3>
      <p class="mt-1 text-xs text-subtle">近 14 日</p>
    </div>
    <div class="text-right">
      <div class="text-2xl font-semibold text-accent">{total}</div>
      <div class="text-xs text-subtle">次访问</div>
    </div>
  </div>
  <svg viewBox="0 0 100 52" class="h-24 w-full overflow-visible" role="img" aria-label="访问趋势图">
    <polyline points={points} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent" />
    {chartPoints.map(point => (
      <circle cx={point.x} cy={point.y} r="1.8" class="fill-accent"><title>{point.date}: {point.count}</title></circle>
    ))}
  </svg>
</section>
