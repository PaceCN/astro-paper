---
import PostCard from './PostCard.astro';

type Post = {
  title: string;
  slug: string;
  content?: string;
  description?: string;
  createdAt?: string | number | Date;
  tags?: string;
  category?: string;
  featured?: boolean;
};

type Props = { posts: Post[]; tagsEnabled?: boolean };
const { posts, tagsEnabled = true } = Astro.props;
---

<section class="mt-10">
  <div class="mb-4 flex items-center justify-between gap-3">
    <h2 class="text-xl font-semibold">相关推荐</h2>
    <a href="/archive/" class="text-sm text-accent hover:underline">查看归档</a>
  </div>
  {posts.length ? (
    <div class="grid gap-4 md:grid-cols-3">
      {posts.map(post => <PostCard post={post} compact tagsEnabled={tagsEnabled} />)}
    </div>
  ) : (
    <p class="surface-card p-5 text-sm text-subtle">相关文章会在内容增多后显示。</p>
  )}
</section>
