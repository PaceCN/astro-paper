---
import type { HTMLAttributes } from "astro/types";
import { SITE } from '@/config';

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer class:list={["app-layout", { "mt-auto": !noMarginTop }, className]} {...attrs}>
  <div class="mt-10 border-t border-border py-8 text-center text-sm text-subtle">
    <p>© {currentYear} {SITE.title} · {SITE.author} · 热爱分享，记录技术与生活的点滴 · <a href="/rss.xml" class="text-accent hover:underline">RSS</a></p>
  </div>
</footer>
